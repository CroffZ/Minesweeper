
# ==========================================
# Build Outputs & Artifacts
# ==========================================
target/
out/
*.class
*.jar
*.war
*.ear

# ==========================================
# Log & Crash Files
# ==========================================
*.log
hs_err_pid*
replay_pid*

# ==========================================
# IntelliJ IDEA
# ==========================================
# User-specific & temporary settings (never commit)
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/caches
.idea/contentModel.xml
.idea/dataSources/
.idea/dataSources.local.xml
.idea/httpRequests/
.idea/sonarlint/
.idea/*DiffState.xml
*.iws

# Maven projects regenerate these automatically upon import:
*.iml
.idea/modules.xml
.idea/misc.xml
.idea/compiler.xml
.idea/jarRepositories.xml

# Note: Shared configurations in .run/ and .idea/runConfigurations/
# as well as .idea/vcs.xml and .idea/codeStyles/ are intentionally kept.

# ==========================================
# OS-Specific (macOS, Windows, Linux)
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
